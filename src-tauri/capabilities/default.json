{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "clipboard-manager:allow-read-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "store:default"
  ]
}
